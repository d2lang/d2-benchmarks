      rectangle "<size:13><color:#D6E4F7><plain>tables on the metadata instead of rebuilt per layer ⇒ roughly 4 host/device barriers per pass, not one set per layer</plain></color></size>" as n023 #back:1565c0;line:1565c0;text:D6E4F7
