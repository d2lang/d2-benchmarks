      rectangle "<size:13><color:#CFD2DD><plain>batches S requests carrying T tokens in total · chunked prefill off</plain></color></size>\n<size:13><color:#CFD2DD><plain>never subclassed, its output never mutated</plain></color></size>" as n003 #back:37474f;line:37474f;text:CFD2DD
    }
