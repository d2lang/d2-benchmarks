        rectangle "<size:12><color:#5d4037><plain>T = 110 → T&#95;padded = 128 · S = 3 → 4 · L = 64 · grid = 4 × 64. Note S × L ≠ T.</plain></color></size>" as n038 #back:FFF8E1;line:FFF8E1;text:5d4037
