        rectangle "<size:12><color:#D6E4F7><plain>torch.compile(model, backend='inductor',</plain></color></size>\n<size:12><color:#D6E4F7><plain>fullgraph=True, dynamic=False)</plain></color></size>" as n041 #back:1565c0;line:1565c0;text:D6E4F7
