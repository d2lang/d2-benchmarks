      "d2_id": "lower.strategies.dense",
      "dot_id": "cluster_n054",
      "parent_d2_id": "lower.strategies",
      "parent_dot_id": "cluster_n053",
      "kind": "group",
      "label": "A · Dense grid, the strategy shown above",
      "source_shape": "rectangle",
      "dot_shape": "cluster",
      "differences": [
        "grid layout constraint omitted",
