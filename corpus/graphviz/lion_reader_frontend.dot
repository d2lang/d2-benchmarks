    node_n014 [id="node_n014", label="Sidebar", d2_id="ui.sidebar", semantic_kind="node", shape="box"];
    node_n015 [id="node_n015", label="UnifiedEntriesContent", d2_id="ui.unified_entries", semantic_kind="node", shape="box"];
    node_n016 [id="node_n016", label="EntryListContainer", d2_id="ui.suspending_list", semantic_kind="node", shape="box"];
    node_n017 [id="node_n017", label="EntryList", d2_id="ui.entry_list", semantic_kind="node", shape="box"];
