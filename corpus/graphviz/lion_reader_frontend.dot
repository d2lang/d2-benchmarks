  node_n010 -> proxy_n007 [id="edge002", d2_id="(hooks.useRealtimeUpdates -> client.cache_helpers)[0]", label="subscription_created\nsubscription_deleted", dir="forward", arrowtail="none", arrowhead="normal", color="#388e3c", lhead="cluster_n007"];
