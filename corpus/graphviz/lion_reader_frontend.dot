  proxy_n005 -> node_n016 [id="edge006", d2_id="(client.react_query -> ui.suspending_list)[0]", label="Paginated entries\n(suspending)", dir="forward", arrowtail="none", arrowhead="normal", color="#7b1fa2", ltail="cluster_n005"];
  node_n016 -> node_n017 [id="edge007", d2_id="ui.(suspending_list -> entry_list)[0]", label="Entries with\nread/starred state", dir="forward", arrowtail="none", arrowhead="normal", color="#7b1fa2", penwidth="2"];
  proxy_n005 -> node_n014 [id="edge008", d2_id="(client.react_query -> ui.sidebar)[0]", label="Subscriptions/tags\nwith counts", dir="forward", arrowtail="none", arrowhead="normal", color="#7b1fa2", ltail="cluster_n005"];
  node_n017 -> node_n011 [id="edge009", d2_id="(ui.entry_list -> hooks.useEntryMutations)[0]", label="User action\n(toggle read)", dir="forward", arrowtail="none", arrowhead="normal", color="#f57c00"];
  node_n011 -> node_n002 [id="edge010", d2_id="(hooks.useEntryMutations -> server.api)[0]", label="1. Server mutation", dir="forward", arrowtail="none", arrowhead="normal", color="#f57c00"];
  node_n002 -> node_n011 [id="edge011", d2_id="(server.api -> hooks.useEntryMutations)[0]", label="2. Response with\nsubscription context", dir="forward", arrowtail="none", arrowhead="normal", color="#f57c00", style="dashed"];
  node_n011 -> proxy_n007 [id="edge012", d2_id="(hooks.useEntryMutations -> client.cache_helpers)[0]", label="3. Update counts\n(instant)", dir="forward", arrowtail="none", arrowhead="normal", color="#f57c00", penwidth="2", lhead="cluster_n007"];
  node_n011 -> proxy_n005 [id="edge013", d2_id="(hooks.useEntryMutations -> client.react_query)[0]", label="4. Invalidate\nentry lists", dir="forward", arrowtail="none", arrowhead="normal", color="#f57c00", style="dashed", lhead="cluster_n005"];
  node_n016 -> node_n012 [id="edge014", d2_id="(ui.suspending_list -> hooks.useKeyboardShortcuts)[0]", label="Keyboard navigation", dir="forward", arrowtail="none", arrowhead="normal", color="#9e9e9e", style="dashed"];
  node_n015 -> node_n018 [id="edge015", d2_id="ui.(unified_entries -> entry_content)[0]", label="Entry view with\nswipe navigation", dir="forward", arrowtail="none", arrowhead="normal", color="#9e9e9e", style="dashed"];
}
