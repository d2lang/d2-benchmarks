  }
  subgraph cluster_n019 {
    graph [id="cluster_n019", label="Legend", d2_id="legend", semantic_kind="group", color="#e0e0e0", fillcolor="#fafafa", style="filled", labelloc="t", labeljust="l", margin="12"];
    node_n020 [id="node_n020", label="Blue: Initial data fetch", d2_id="legend.initial", semantic_kind="node", shape="box"];
    node_n021 [id="node_n021", label="Green: Real-time updates (SSE)", d2_id="legend.realtime", semantic_kind="node", shape="box"];
    node_n022 [id="node_n022", label="Purple: Query data flow", d2_id="legend.query", semantic_kind="node", shape="box"];
    node_n023 [id="node_n023", label="Orange: User mutations", d2_id="legend.mutation", semantic_kind="node", shape="box"];
