      node_n006 [id="node_n006", label="Server state cache\n- entries.list (infinite)\n- entries.get\n- entries.count\n- subscriptions.list\n- tags.list", d2_id="client.react_query.description", semantic_kind="node", shape="plaintext", color="transparent", fillcolor="transparent"];
    }
