      graph [id="cluster_n007", label="Cache Helpers", d2_id="client.cache_helpers", semantic_kind="group", fillcolor="#a5d6a7", style="filled", labelloc="t", labeljust="l", margin="12"];
      proxy_n007 [id="proxy_n007", shape="point", label="", width="0.01", height="0.01", fixedsize="true", style="invis", synthetic_for="client.cache_helpers"];
      node_n008 [id="node_n008", label="src/lib/cache/\n- adjustSubscriptionUnreadCounts\n- adjustTagUnreadCounts\n- addSubscriptionToCache\n- updateEntriesReadStatus", d2_id="client.cache_helpers.description", semantic_kind="node", shape="plaintext", color="transparent", fillcolor="transparent"];
    }
  }
  subgraph cluster_n009 {
