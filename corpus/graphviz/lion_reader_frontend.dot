  edge [fontname="Helvetica", fontsize="14", color="#333333"];
  node_n000 [id="node_n000", label="Frontend Data Flow", d2_id="title", semantic_kind="node", fontsize="24", fontname="Helvetica-Bold", shape="plaintext", color="transparent", fillcolor="transparent"];
  subgraph cluster_n001 {
    graph [id="cluster_n001", label="Server", d2_id="server", semantic_kind="group", fillcolor="#e3f2fd", style="filled", labelloc="t", labeljust="l", margin="12"];
