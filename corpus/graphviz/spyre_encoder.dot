  }
  subgraph cluster_n052 {
    graph [id="cluster_n052", label="Attention shape strategy: dense grid today, and planned flash attention", d2_id="lower", semantic_kind="group", color="#CFD2DD", fillcolor="#EEF1F8", fontsize="20", fontcolor="#212121", fontname="Helvetica-Bold", style="filled,rounded", labelloc="t", labeljust="l", margin="12"];
    subgraph cluster_n053 {
      graph [id="cluster_n053", label=" ", d2_id="lower.strategies", semantic_kind="group", color="#EEF1F8", fillcolor="#EEF1F8", style="filled", labelloc="t", labeljust="l", margin="12"];
      subgraph cluster_n054 {
        graph [id="cluster_n054", label="A · Dense grid, the strategy shown above", d2_id="lower.strategies.dense", semantic_kind="group", color="#0d47a1", fillcolor="#E3E9FD", penwidth="2", fontsize="15", fontcolor="#0A0F25", fontname="Helvetica-Bold", style="filled,rounded", labelloc="t", labeljust="l", margin="12"];
        node_n055 [id="node_n055", label="Pack the ragged flat list into a rectangle, so every  \nshape is fixed at compile time.  \nNeeded because an offset computed from data does not  \nlower under compilation (torch-spyre#3508) — exactly  \nthe arithmetic that flash relies on.  \nEager tolerates it; compiled mode, our target, does not.\n\n· build an additive mask [S, 1, L, L] marking padding  \nand cross-request slots  \n· build three index lists, then gather Q / K / V into  \n[S, H, L, D]  \n· one fused SDPA kernel per (S, L), then gather the  \nresults back out\n\n**Shape axes: T for the body, (S, L) for attention.  \nTwo sets of buckets to warm.**\n\nCosts: the mask grows with L², plus index lists and a  \nbarrier per gather.  \nWorks today. This is the current implementation.", d2_id="lower.strategies.dense.dense_body", semantic_kind="node", color="transparent", fillcolor="transparent", fontsize="14", fontcolor="#0A0F25", shape="plaintext"];
      }
      subgraph cluster_n056 {
        graph [id="cluster_n056", label="B · Flash-style attention, planned", d2_id="lower.strategies.flash", semantic_kind="group", color="#2e7d32", fillcolor="#E8F5E9", penwidth="2", fontsize="15", fontcolor="#0A0F25", fontname="Helvetica-Bold", style="filled,rounded", labelloc="t", labeljust="l", margin="12"];
        node_n057 [id="node_n057", label="Never materialise the rectangle.  \nEach block of queries reads its request's offset from  \nthe metadata at runtime, and works directly on the flat  \nlist, carrying a running softmax maximum and sum.  \nThat is the online-softmax structure the Spyre decoder  \nalready uses over KV pages.\n\n· no [S, 1, L, L] mask; request boundaries are the offsets  \n· no gather_pack / gather_unpack; the kernel reads the  \nflat list directly  \n· no per-layer index lists, so no per-gather barriers\n\n**Shape axis: block count, bucketed like the decoder's  \npage loop. L disappears.**\n\nBoth upstream backends already work this way, neither  \npadding into a rectangle.  \nFlash attention consumes the flat list with  \ncu_seqlens_q = query_start_loc, and the CPU backend  \npasses query[:num_actual_tokens] to a C++ kernel.", d2_id="lower.strategies.flash.flash_body", semantic_kind="node", color="transparent", fillcolor="transparent", fontsize="14", fontcolor="#0A0F25", shape="plaintext"];
      }
    }
    subgraph cluster_n058 {
      graph [id="cluster_n058", label=" ", d2_id="lower.footer", semantic_kind="group", color="#EEF1F8", fillcolor="#EEF1F8", style="filled", labelloc="t", labeljust="l", margin="12"];
      subgraph cluster_n059 {
        graph [id="cluster_n059", label="If flash attention lands, the design converges on upstream", d2_id="lower.footer.simplifies", semantic_kind="group", color="#F9A825", fillcolor="#FFF8E1", penwidth="2", fontsize="15", fontcolor="#5d4037", fontname="Helvetica-Bold", style="filled,rounded", labelloc="t", labeljust="l", margin="12"];
        node_n060 [id="node_n060", label="· the second shape axis collapses; bucket T and a block count,  \nmuch closer to upstream's single axis  \n· the batch-shape tables box disappears, and with it the  \nper-layer rebuild problem and its barriers  \n· gather_pack / SDPA / gather_unpack collapse into one  \nblocked-attention kernel  \n· the mask's L² growth at long prompts disappears, today's  \nlargest untested risk\n\nOpen question: whether a Spyre kernel can do the runtime  \noffset arithmetic this depends on. If it cannot, the block  \ncount stays bucketed.  \nEverything else holds either way: padding seam, unpadded  \nmetadata, warmup, compilation mode.", d2_id="lower.footer.simplifies.simplifies_body", semantic_kind="node", color="transparent", fillcolor="transparent", fontsize="14", fontcolor="#5d4037", shape="plaintext"];
      }
      subgraph cluster_n061 {
        graph [id="cluster_n061", label="Legend", d2_id="lower.footer.legend", semantic_kind="group", color="#CFD2DD", fillcolor="#FFFFFF", fontsize="20", fontcolor="#212121", fontname="Helvetica-Bold", style="filled,rounded", labelloc="t", labeljust="l", margin="12"];
        node_n062 [id="node_n062", label="Upstream vLLM, used as-is", d2_id="lower.footer.legend.L1", semantic_kind="node", color="#263238", fillcolor="#37474f", fontsize="14", fontcolor="#ffffff", style="filled,rounded", shape="box"];
        node_n063 [id="node_n063", label="spyre-inference component", d2_id="lower.footer.legend.L2", semantic_kind="node", color="#0d47a1", fillcolor="#1565c0", fontsize="14", fontcolor="#ffffff", style="filled,rounded", shape="box"];
        node_n064 [id="node_n064", label="Internal step · dense-grid path", d2_id="lower.footer.legend.L3", semantic_kind="node", color="#0d47a1", fillcolor="#E3E9FD", fontsize="14", fontcolor="#0A0F25", style="filled,rounded", shape="box"];
        node_n065 [id="node_n065", label="Planned flash-attention path", d2_id="lower.footer.legend.L4", semantic_kind="node", color="#2e7d32", fillcolor="#E8F5E9", fontsize="14", fontcolor="#0A0F25", style="filled,rounded", shape="box"];
