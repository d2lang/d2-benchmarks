        subgraph cluster_n040 {
          graph [id="cluster_n040", label="CompilationMode.STOCK_TORCH_COMPILE", d2_id="upper.sidebar.compile_mode.mode", semantic_kind="group", color="#0d47a1", fillcolor="#1565c0", fontsize="14", fontcolor="#ffffff", fontname="Helvetica-Bold", style="filled,rounded", labelloc="t", labeljust="l", margin="12"];
          node_n041 [id="node_n041", label="torch.compile(model, backend='inductor',\nfullgraph=True, dynamic=False)", d2_id="upper.sidebar.compile_mode.mode.mode_d", semantic_kind="node", color="#1565c0", fillcolor="#1565c0", fontsize="12", fontcolor="#D6E4F7", style="filled", shape="box"];
        }
        node_n042 [id="node_n042", label="dynamic=False → sizes are baked in as constants.  \nA graph built for 128 tokens works only for 128.  \nA new count means a new compile.", d2_id="upper.sidebar.compile_mode.static_shapes", semantic_kind="node", color="transparent", fillcolor="transparent", fontsize="14", fontcolor="#37474f", shape="plaintext"];
