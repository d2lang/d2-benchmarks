          node_n036 [id="node_n036", label="every request gets one row of L columns; L = align_up(longest prompt, 64)\nshort requests leave their remaining columns as padding", d2_id="upper.sidebar.shapes.L_width.L_width_d", semantic_kind="node", color="#E3E9FD", fillcolor="#E3E9FD", fontsize="12", fontcolor="#37474f", style="filled", shape="box"];
