      }
      subgraph cluster_n050 {
        graph [id="cluster_n050", label="Design invariants", d2_id="upper.sidebar.invariants", semantic_kind="group", color="#CFD2DD", fillcolor="#EEF1F8", fontsize="20", fontcolor="#212121", fontname="Helvetica-Bold", style="filled,rounded", labelloc="t", labeljust="l", margin="12"];
        node_n051 [id="node_n051", label="· The metadata always describes the real batch, so no  \npadded row is ever pooled.\n\n· Padding the body is safe: each layer treats every  \ntoken row on its own.", d2_id="upper.sidebar.invariants.rules", semantic_kind="node", color="transparent", fillcolor="transparent", fontsize="14", fontcolor="#37474f", shape="plaintext"];
      }
