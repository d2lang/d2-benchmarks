          node_n049 [id="node_n049", label="warms pooler shapes · upstream's version is only a memory probe", d2_id="upper.sidebar.warmup.pool.pool_d", semantic_kind="node", color="#1565c0", fillcolor="#1565c0", fontsize="12", fontcolor="#D6E4F7", style="filled", shape="box"];
