          node_n038 [id="node_n038", label="T = 110 → T_padded = 128 · S = 3 → 4 · L = 64 · grid = 4 × 64. Note S × L ≠ T.", d2_id="upper.sidebar.shapes.example.example_d", semantic_kind="node", color="#FFF8E1", fillcolor="#FFF8E1", fontsize="12", fontcolor="#5d4037", style="filled", shape="box"];
