        subgraph cluster_n044 {
          graph [id="cluster_n044", label="for T in token buckets: _dummy_run(T)", d2_id="upper.sidebar.warmup.bodies", semantic_kind="group", color="#0d47a1", fillcolor="#1565c0", fontsize="14", fontcolor="#ffffff", fontname="Helvetica-Bold", style="filled,rounded", labelloc="t", labeljust="l", margin="12"];
          node_n045 [id="node_n045", label="one compiled body graph per bucket", d2_id="upper.sidebar.warmup.bodies.bodies_d", semantic_kind="node", color="#1565c0", fillcolor="#1565c0", fontsize="12", fontcolor="#D6E4F7", style="filled", shape="box"];
        }
        subgraph cluster_n046 {
          graph [id="cluster_n046", label="for (S, L): _dummy_run(force_attention=True)", d2_id="upper.sidebar.warmup.attn", semantic_kind="group", color="#0d47a1", fillcolor="#1565c0", fontsize="14", fontcolor="#ffffff", fontname="Helvetica-Bold", style="filled,rounded", labelloc="t", labeljust="l", margin="12"];
          node_n047 [id="node_n047", label="without the flag no attention metadata is built,\nso the attention path is never traced or compiled", d2_id="upper.sidebar.warmup.attn.attn_d", semantic_kind="node", color="#1565c0", fillcolor="#1565c0", fontsize="12", fontcolor="#D6E4F7", style="filled", shape="box"];
        }
        subgraph cluster_n048 {
