  node [shape="box", fontname="Helvetica", fontsize="14", color="#333333", margin="0.12,0.08"];
  edge [fontname="Helvetica", fontsize="14", color="#333333"];
  node_n000 [id="node_n000", label="ouroboros-leios-sim - Component Diagram", d2_id="title", semantic_kind="node", fontsize="24", fontname="Helvetica-Bold", shape="plaintext", color="transparent", fillcolor="transparent"];
  subgraph cluster_n001 {
    graph [id="cluster_n001", label="Protocol Engine", d2_id="protocol-engine", semantic_kind="group", color="#2a2a2a", fillcolor="#f5f5f5", fontcolor="#2a2a2a", style="filled,rounded", labelloc="t", labeljust="l", margin="12"];
