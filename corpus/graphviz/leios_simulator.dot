    node_n021 [id="node_n021", label="Model\n\nComputes state and metrics from trace", d2_id="monitor.metrics", semantic_kind="node", color="#2a2a2a", fillcolor="#ffffff", fontcolor="#2a2a2a", style="filled,rounded", shape="box"];
    node_n022 [id="node_n022", label="Event Tracer\n\nCollects trace of\nnode and network events", d2_id="monitor.tracer", semantic_kind="node", color="#2a2a2a", fillcolor="#ffffff", fontcolor="#2a2a2a", style="filled,rounded", shape="box"];
    node_n023 [id="node_n023", label="IO-Sim library\n\nSimulates threading, clocks, STM, ..", d2_id="monitor.io-sim", semantic_kind="node", color="#2a2a2a", fillcolor="#ffffff", fontcolor="#2a2a2a", style="filled,dashed,rounded", shape="box"];
    node_n024 [id="node_n024", label="File-System", d2_id="monitor.file-system", semantic_kind="node", color="#2a2a2a", fillcolor="#ffffff", fontcolor="#2a2a2a", style="filled,dashed,rounded", shape="box"];
