    node_n017 [id="node_n017", label="Protocol Renderer\n\nRenders mini-protocol\n messages and node state\n(made for small sims)", d2_id="viz-engine.protocol-viz", semantic_kind="node", color="#2a2a2a", fillcolor="#ffffff", fontcolor="#2a2a2a", style="filled,rounded", shape="box"];
    node_n018 [id="node_n018", label="P2P Renderer\n\nVisualizes P2P\nnetwork state\nand charts\n(made for ~100 nodes sims)", d2_id="viz-engine.p2p-viz", semantic_kind="node", color="#2a2a2a", fillcolor="#ffffff", fontcolor="#2a2a2a", style="filled,rounded", shape="box"];
    node_n019 [id="node_n019", label="Frame Output\n\nOutputs animation frames\n(on-screen or as PNG files)", d2_id="viz-engine.frame-output", semantic_kind="node", color="#2a2a2a", fillcolor="#ffffff", fontcolor="#2a2a2a", style="filled,rounded", shape="box"];
