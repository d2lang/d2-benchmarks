  proxy_n001 -> proxy_n011 [id="edge008", d2_id="(protocol-engine -> channel-layer)[0]", label="Uses for messaging", dir="forward", arrowtail="none", arrowhead="normal", ltail="cluster_n001", lhead="cluster_n011"];
  node_n002 -> node_n004 [id="edge009", d2_id="protocol-engine.(praos -> block-fetch)[0]", label="Bodies diffusion", dir="forward", arrowtail="none", arrowhead="normal"];
  node_n002 -> node_n003 [id="edge010", d2_id="protocol-engine.(praos -> chain-sync)[0]", label="Headers diffusion", dir="forward", arrowtail="none", arrowhead="normal"];
  proxy_n005 -> node_n002 [id="edge011", d2_id="protocol-engine.(leios -> praos)[0]", label="Extends consensus", dir="forward", arrowtail="none", arrowhead="normal", ltail="cluster_n005"];
  proxy_n005 -> node_n009 [id="edge012", d2_id="protocol-engine.(leios -> relay)[0]", label="Uses for diffusion", dir="forward", arrowtail="none", arrowhead="normal", ltail="cluster_n005"];
  node_n010 -> node_n002 [id="edge013", d2_id="protocol-engine.(node-manager -> praos)[0]", label="Manages ranking blocks\nvalidation/generation", dir="forward", arrowtail="none", arrowhead="normal"];
  node_n010 -> proxy_n005 [id="edge014", d2_id="protocol-engine.(node-manager -> leios)[0]", label="Manages ledger state\nand validation/generation", dir="forward", arrowtail="none", arrowhead="normal", lhead="cluster_n005"];
  proxy_n015 -> proxy_n020 [id="edge015", d2_id="(viz-engine -> monitor)[0]", label="Visualizes state and metrics", dir="forward", arrowtail="none", arrowhead="normal", ltail="cluster_n015", lhead="cluster_n020"];
  proxy_n020 -> proxy_n011 [id="edge016", d2_id="(monitor -> channel-layer)[0]", label="Traces network events", dir="forward", arrowtail="none", arrowhead="normal", ltail="cluster_n020", lhead="cluster_n011"];
