    node_n002 [id="node_n002", label="Praos Protocol\n\nImplements consensus", d2_id="protocol-engine.praos", semantic_kind="node", color="#2a2a2a", fillcolor="#ffffff", fontcolor="#2a2a2a", style="filled,rounded", shape="box"];
    node_n003 [id="node_n003", label="Chain-Sync Mini-Protocol\n\nReconstrucs blockchain of peers", d2_id="protocol-engine.chain-sync", semantic_kind="node", color="#2a2a2a", fillcolor="#ffffff", fontcolor="#2a2a2a", style="filled,rounded", shape="box"];
    node_n004 [id="node_n004", label="Block-Fetch Mini-Protocol\n\nFetches bodies of selected chain", d2_id="protocol-engine.block-fetch", semantic_kind="node", color="#2a2a2a", fillcolor="#ffffff", fontcolor="#2a2a2a", style="filled,rounded", shape="box"];
    subgraph cluster_n005 {
      graph [id="cluster_n005", label="Leios Protocol", d2_id="protocol-engine.leios", semantic_kind="group", color="#2a2a2a", fillcolor="#ffffff", fontcolor="#2a2a2a", style="filled,rounded", labelloc="t", labeljust="l", margin="12"];
      proxy_n005 [id="proxy_n005", shape="point", label="", width="0.01", height="0.01", fixedsize="true", style="invis", synthetic_for="protocol-engine.leios"];
      node_n006 [id="node_n006", label="Input Blocks Relay", d2_id="protocol-engine.leios.ib-relay", semantic_kind="node", color="#666666", fillcolor="#ffffff", fontcolor="#2a2a2a", style="filled,rounded", shape="box"];
      node_n007 [id="node_n007", label="Endorse Blocks Relay", d2_id="protocol-engine.leios.eb-relay", semantic_kind="node", color="#666666", fillcolor="#ffffff", fontcolor="#2a2a2a", style="filled,rounded", shape="box"];
      node_n008 [id="node_n008", label="Vote Messages Relay", d2_id="protocol-engine.leios.vote-relay", semantic_kind="node", color="#666666", fillcolor="#ffffff", fontcolor="#2a2a2a", style="filled,rounded", shape="box"];
    }
    node_n009 [id="node_n009", label="Relay Mini-Protocol\n\nRelays messages\nwith configurable priority", d2_id="protocol-engine.relay", semantic_kind="node", color="#2a2a2a", fillcolor="#ffffff", fontcolor="#2a2a2a", style="filled,rounded", shape="box"];
    node_n010 [id="node_n010", label="Node\n\nManages node state and\nprotocol interactions", d2_id="protocol-engine.node-manager", semantic_kind="node", color="#2a2a2a", fillcolor="#ffffff", fontcolor="#2a2a2a", style="filled,rounded", shape="box"];
  }
  subgraph cluster_n011 {
    graph [id="cluster_n011", label="Channel Layer", d2_id="channel-layer", semantic_kind="group", color="#2a2a2a", fillcolor="#f5f5f5", fontcolor="#2a2a2a", style="filled,rounded", labelloc="t", labeljust="l", margin="12"];
    proxy_n011 [id="proxy_n011", shape="point", label="", width="0.01", height="0.01", fixedsize="true", style="invis", synthetic_for="channel-layer"];
    node_n012 [id="node_n012", label="Generic Channel\n\nBase channel abstraction", d2_id="channel-layer.chan", semantic_kind="node", color="#2a2a2a", fillcolor="#ffffff", fontcolor="#2a2a2a", style="filled,rounded", shape="box"];
    node_n013 [id="node_n013", label="TCP Model\n\nSimulates TCP behavior", d2_id="channel-layer.tcp", semantic_kind="node", color="#2a2a2a", fillcolor="#ffffff", fontcolor="#2a2a2a", style="filled,rounded", shape="box"];
    node_n014 [id="node_n014", label="Channel Multiplexer\n\nMultiplexes protocols", d2_id="channel-layer.mux", semantic_kind="node", color="#2a2a2a", fillcolor="#ffffff", fontcolor="#2a2a2a", style="filled,rounded", shape="box"];
  }
  subgraph cluster_n015 {
    graph [id="cluster_n015", label="Visualization Engine", d2_id="viz-engine", semantic_kind="group", color="#2a2a2a", fillcolor="#f5f5f5", fontcolor="#2a2a2a", style="filled,rounded", labelloc="t", labeljust="l", margin="12"];
    proxy_n015 [id="proxy_n015", shape="point", label="", width="0.01", height="0.01", fixedsize="true", style="invis", synthetic_for="viz-engine"];
